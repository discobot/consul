#!/usr/bin/env node
/**
 * council launcher: starts pi with the council extension and its
 * custom TUI skin preloaded. All arguments pass through to pi.
 *
 * pi is resolved from $COUNCIL_PI (a pi binary or a cli.js/cli.ts entry),
 * falling back to `pi` on PATH.
 */

import { spawnSync } from "node:child_process";
import { constants as osConstants } from "node:os";
import * as path from "node:path";
import { fileURLToPath } from "node:url";

const root = path.dirname(path.dirname(fileURLToPath(import.meta.url)));
const boardMode = process.argv[2] === "board";
const extensionArgs = boardMode
	? ["-e", path.join(root, "src", "cockpit.ts")]
	: ["-e", path.join(root, "index.ts"), "-e", path.join(root, "src", "tui-skin.ts")];
const passThrough = process.argv.slice(boardMode ? 3 : 2);

const override = process.env.COUNCIL_PI;
const invocation = override
	? /\.(js|ts|mjs)$/.test(override)
		? { command: process.execPath, args: [override] }
		: { command: override, args: [] }
	: { command: "pi", args: [] };

const result = spawnSync(invocation.command, [...invocation.args, ...extensionArgs, ...passThrough], {
	stdio: "inherit",
	env: boardMode ? { ...process.env, COUNCIL_OWNER_ARGS: JSON.stringify(passThrough) } : process.env,
});

if (result.error) {
	const target = [invocation.command, ...invocation.args].join(" ");
	const recovery =
		override === undefined
			? "Install pi (npm i -g @earendil-works/pi-coding-agent), or set COUNCIL_PI to a pi binary or cli.js/cli.ts entry."
			: "Check that COUNCIL_PI names an executable pi binary or a readable cli.js/cli.ts entry.";
	console.error(`council: could not run ${JSON.stringify(target)}: ${result.error.message}\n${recovery}`);
	process.exit(1);
}

if (result.signal) {
	const signalNumber = osConstants.signals[result.signal];
	const exitCode = signalNumber ? 128 + signalNumber : 1;
	console.error(`council: pi target ${JSON.stringify(invocation.command)} terminated by ${result.signal}; exiting ${exitCode}.`);
	process.exit(exitCode);
}
process.exit(result.status ?? 1);
